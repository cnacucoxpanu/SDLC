@startuml activity_booking
' Диаграмма активности: от поиска оборудования до возврата (UC-08, UC-09, UC-11, UC-12, UC-13)
skinparam shadowing false

|Студент|
start
:Найти оборудование;
repeat
  :Выбрать период;
  |Система|
  :Проверить правила брони;
  if (Правила выполнены?) then (нет)
    |Студент|
    :Увидеть причину отказа;
  else (да)
    break
  endif
repeat while (Повторить?) is (да)
|Система|
:Создать бронь «Активна»;
if (Студент отменил бронь?) then (да)
  |Студент|
  :Отменить бронь;
  stop
else (нет)
endif
repeat
  |Лаборант|
  :Отметить выдачу;
  |Система|
  :Проверить период и статус;
repeat while (Можно выдать?) is (нет) not (да)
:Бронь «Выдана», записать дату выдачи;
|Студент|
:Использовать оборудование;
|Система|
if (Срок брони прошёл?) then (да)
  :Показать как просроченную;
else (нет)
endif
|Лаборант|
:Принять возврат;
|Система|
:Бронь «Возвращена», записать дату возврата;
stop
@enduml
