@startuml sequence_booking
' Диаграмма последовательности: бронирование (UC-08, UC-09)
skinparam shadowing false
hide footbox

participant ":Студент" as S
participant ":BookingDialog" as D
participant ":BookingService" as B
participant ":Store" as T
participant "b:Booking" as X

activate S
S -> D : ввести даты, «Забронировать»
activate D
D -> B : book(student, equipmentId, from, to)
activate B
B -> T : equipment(), bookings()
activate T
T --> B : списки
B -> B : проверить правила брони
B -->> X : «create»
activate X
destroy X
B -> T : bookings().add(b)
B -> T : save()
T --> B
destroy T
B --> D : b
destroy B
D --> S : бронь оформлена
destroy D
destroy S
@enduml
