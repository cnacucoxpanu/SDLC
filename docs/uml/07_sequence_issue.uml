@startuml sequence_issue
' Диаграмма последовательности: выдача и возврат (UC-12, UC-13). Реализация запланирована на I3–I4
skinparam shadowing false
hide footbox

participant ":Лаборант" as L
participant ":JournalPanel" as J
participant ":IssueService" as I
participant ":Store" as T
participant "b:Booking" as X

activate L
L -> J : «Выдать»
activate J
J -> I : issue(actor, bookingId)
activate I
I -> T : bookings(), equipment()
activate T
T --> I : списки
I -> I : проверить период и статус
I -> X : issued(сегодня)
activate X
X --> I
I -> T : replaceBooking(b), save()
T --> I
I --> J : b
J --> L : статус «Выдана»

L -> J : «Принять»
J -> I : accept(actor, bookingId)
I -> X : returned(сегодня)
X --> I
destroy X
I -> T : replaceBooking(b), save()
T --> I
destroy T
I --> J : b
destroy I
J --> L : статус «Возвращена»
destroy J
destroy L
@enduml
